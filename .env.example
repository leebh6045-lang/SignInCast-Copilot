# ===== 运行环境 =====
COPILOT_ENV=dev
COPILOT_LOG_LEVEL=INFO

# ===== 模型后端 =====
# fake: 离线规则模型，不联网、不需要 key（默认，用于开发与测试）
# openai_compat: 任意 OpenAI 兼容接口（DeepSeek / 通义 / 智谱 / Kimi / Ollama）
COPILOT_LLM_PROVIDER=fake
COPILOT_LLM_BASE_URL=https://api.deepseek.com/v1
COPILOT_LLM_API_KEY=
COPILOT_LLM_MODEL=deepseek-chat
COPILOT_LLM_TIMEOUT_S=60
COPILOT_LLM_MAX_RETRIES=2

# ===== 运行预算（控制失控与成本）=====
COPILOT_MAX_STEPS=8
COPILOT_CONTEXT_TOKEN_BUDGET=8000
COPILOT_RUN_TOKEN_BUDGET=30000
COPILOT_RUN_TIMEOUT_S=120
COPILOT_TOOL_RESULT_MAX_CHARS=4000

# ===== SignInCast 业务系统 =====
COPILOT_SIGNINCAST_BASE_URL=https://signin.qishiyi.cn
COPILOT_SIGNINCAST_USERNAME=
COPILOT_SIGNINCAST_PASSWORD=
COPILOT_SIGNINCAST_TIMEOUT_S=15
COPILOT_SIGNINCAST_MAX_RETRIES=2
# mock: 只读本地录制响应（默认，离线可跑）
# record: 调用真实接口并把响应录制到 COPILOT_SIGNINCAST_FIXTURES_DIR
# live: 调用真实接口，不录制
COPILOT_SIGNINCAST_MODE=mock
COPILOT_SIGNINCAST_FIXTURES_DIR=data/fixtures/http

# ===== 可观测 =====
COPILOT_TRACE_ENABLED=true
COPILOT_TRACE_DIR=traces

# ===== 成本估算（每百万 token，仅用于估算）=====
COPILOT_PROMPT_PRICE_PER_MTOK=0.5
COPILOT_COMPLETION_PRICE_PER_MTOK=2.0
